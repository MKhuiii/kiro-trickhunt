# TrickHunt LLM settings (server only).
# Copy this file to .env and fill in your own values. Never commit .env.
# Do not use the NEXT_PUBLIC_ prefix: none of these may reach the browser.
# If the key, model or base URL is missing or invalid, the app runs in
# rules-only mode (no LLM). That is a normal state, not an error.

# Optional. Free-text label for your provider, used only in smoke-test output.
# Trimmed and length-limited. It does not change requests.
LLM_PROVIDER=your-provider-name

# Required. API key for the provider. Sent only in the Authorization header.
LLM_API_KEY=your-api-key-here

# Required. Model identifier as named by your provider.
LLM_MODEL=your-model-name

# Required. Base URL of an OpenAI-compatible API (requests go to
# <base>/chat/completions). Must be https://, or http:// only for localhost,
# 127.0.0.1 or [::1] (local models). No credentials, query or fragment.
# Trailing slashes are removed.
LLM_BASE_URL=https://api.example.com/v1

# Optional. Max tokens the model may generate per request (integer).
# Default 400. Allowed range 1 to 2000; values outside are clamped.
LLM_MAX_OUTPUT_TOKENS=400

# Optional. Request timeout in milliseconds (integer).
# Default 7000. Allowed range 500 to 30000; values outside are clamped.
LLM_TIMEOUT_MS=7000
